# Copy to .env.local (gitignored) and fill in. Never commit .env.local.
BEDROCK_API_KEY=            # from the bedrock-mantle console, ap-south-1
ADMIN_TOKEN=                # openssl rand -hex 16, guards pause/resume/reset

# Research agent: fresh web sources attached to every ingested finding.
QUERIT_API_KEY=             # https://www.querit.ai — free tier, 1000 searches/month

# Stage pipelines on RocketRide (scripts/rr_stage.py).
ROCKETRIDE_URI=             # wss://api.rocketride.ai (Cloud) or ws://localhost:5565
ROCKETRIDE_APIKEY=          # from the RocketRide Cloud editor

# Verification sandbox (src/core/sandbox.py): pytest runs inside a Tenki
# session when the CLI is installed and this key is set.
TENKI_API_KEY=              # tk_... key from the Tenki dashboard after onboard

# Data agent (src/core/leads.py): company enrichment via the Glasser CLI.
GLASSER_API_KEY=            # console key; spending needs a funded workspace balance

# Scraping agent (src/core/scrape.py): page fetches via an Apify Actor.
APIFY_TOKEN=                # Personal API token from Apify console settings

